# MQTT broker connection
MQTT_HOST=192.168.1.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topics (must match the HACS component config)
COMMAND_TOPIC=tv_remote/set
STATE_TOPIC=tv_remote/state

# Path to the PowerShell scripts (use forward slashes or escaped backslashes)
SCRIPTS_DIR=./scripts
